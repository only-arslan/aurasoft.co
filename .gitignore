# Secrets — wp-config.php holds DB credentials and auth salts. Never commit it.
wp-config.php
.env
.env.*

# User-generated content and runtime dirs
wp-content/uploads/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/cache/
wp-content/backup-db/
wp-content/blogs.dir/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/db.php
*.log

# Theme/plugin build tooling
node_modules/
vendor/
.sass-cache/
*.map

# Backups — database dumps contain user emails and password hashes, and media
# archives are large. Both belong off-machine, not in version control.
backups/
sql-dumps/
*.sql
*.sql.gz

# Local dev scratch
.local/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Python bytecode — build artifact, regenerated on every run
__pycache__/
*.py[cod]
